# ─── Variáveis de ambiente para o App no EasyPanel ──────────────────────────
# Cole estas no painel do EasyPanel (App > Environment). NÃO comite o .env real.

# Banco: use a connection string do serviço Postgres criado no EasyPanel.
# O host é o nome do serviço interno (ex.: "maturador_postgres"), não localhost.
DATABASE_URL="postgresql://postgres:SENHA@NOME_DO_SERVICO_POSTGRES:5432/maturador"

# Servidor (dentro do container). NÃO mude — o EasyPanel expõe via domínio.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Chave de criptografia das sessões (32+ chars). GERE UMA NOVA, ex.:
#   openssl rand -hex 32
SESSION_ENCRYPTION_KEY="TROQUE_POR_64_HEX_CHARS"

# Domínio público do painel (o mesmo que você apontar no EasyPanel).
# Usado pelo CORS do socket.io. Ex.: https://maturador.seudominio.com
CORS_ORIGIN="https://maturador.SEUDOMINIO.com"

# Proxies residenciais: OBRIGATÓRIO na VPS (IP datacenter é banido pelo WhatsApp).
# Deixe true, mas só conecte chips DEPOIS de cadastrar proxies no painel.
PROXY_AUTO_ASSIGN=true

# (Opcional) integração por API key / JWT próprio para sistemas externos.
# API_KEY="uma-chave-forte-aleatoria"
# JWT_SECRET="outro-segredo-forte"

# Aquecimento (padrões — ajuste se quiser)
WARMUP_DAY1_LIMIT=15
WARMUP_TOTAL_DAYS=15
WARMUP_MAX_DAILY=400
WARMUP_INACTIVITY_RESET_HOURS=72
LOG_LEVEL=info
