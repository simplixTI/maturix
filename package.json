{
  "name": "maturador-whatsapp",
  "version": "1.0.0",
  "description": "WhatsApp number warming/maturation system for enterprise scale",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:web": "npm --prefix web run build",
    "setup": "npm install && npm --prefix web install",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "vitest",
    "lint": "eslint src/"
  },
  "keywords": [
    "whatsapp",
    "warming",
    "maturador",
    "baileys"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.19.3",
    "@whiskeysockets/baileys": "^7.0.0-rc10",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "eventemitter3": "^5.0.4",
    "fastify": "^5.8.5",
    "ffmpeg-static": "^5.3.0",
    "https-proxy-agent": "^9.0.0",
    "jsonwebtoken": "^9.0.3",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "socks-proxy-agent": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
