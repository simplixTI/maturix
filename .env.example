# Database
DATABASE_URL="postgresql://maturador:maturador_secret@localhost:5432/maturador"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
HOST=0.0.0.0

# Security
SESSION_ENCRYPTION_KEY="generate-a-32-byte-hex-key-here"

# Warmup Configuration
WARMUP_DAY1_LIMIT=15
# Total warmup duration (days). The daily limit ramps from WARMUP_DAY1_LIMIT up to
# WARMUP_MAX_DAILY across this many days, then holds. Default 15. Can be overridden
# per-account (PATCH /api/accounts/:id { warmupTotalDays }).
WARMUP_TOTAL_DAYS=15
# Deprecated: ramp growth is now derived from WARMUP_TOTAL_DAYS. Kept for compatibility.
WARMUP_GROWTH_FACTOR=1.35
WARMUP_MAX_DAILY=400
WARMUP_INACTIVITY_RESET_HOURS=72

# Safe Zone Thresholds
SAFE_MSGS_PER_HOUR=30
SAFE_REPLY_RATE_MIN=0.30
SAFE_BLOCK_RATE_MAX=0.02
SAFE_NEW_CONTACTS_PER_DAY=20
SAFE_IDENTICAL_MSGS_PER_HOUR=5

# Session Management
MAX_CONCURRENT_CONNECTIONS=10
RECONNECT_BATCH_SIZE=10
RECONNECT_BATCH_DELAY_MS=5000

# API Security (leave empty to disable auth in dev)
API_KEY=""
CORS_ORIGIN="http://localhost:3001"

# Group Discovery (optional)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Alerts (optional)
ALERT_WEBHOOK_URL=""
