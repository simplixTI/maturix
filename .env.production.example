# ─── Produção (VPS Windows) ───────────────────────────────────────────────
# Copie este arquivo para `.env` na raiz do projeto no servidor e ajuste.
# O script 2-deploy.ps1 gera o SESSION_ENCRYPTION_KEY e monta o DATABASE_URL
# automaticamente — você só confirma o domínio e a senha do Postgres.

# Banco (Postgres local no próprio VPS). Troque a SENHA_DO_POSTGRES.
DATABASE_URL="postgresql://postgres:SENHA_DO_POSTGRES@localhost:5432/maturador"

# Servidor da API (interno; o Caddy expõe via HTTPS no subdomínio)
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Chave de criptografia das sessões (32+ bytes). GERE UMA NOVA no servidor:
#   powershell -Command "[Convert]::ToHexString((1..32 | %{Get-Random -Max 256}))"
SESSION_ENCRYPTION_KEY="GERAR_UMA_CHAVE_HEX_DE_64_CARACTERES"

# Domínio do painel (mesmo do Caddyfile). CORS/socket usam isso.
CORS_ORIGIN="https://maturador.SEUDOMINIO.com"

# Proxies residenciais: atribuir automaticamente ao conectar (no VPS é
# OBRIGATÓRIO — o IP do VPS é datacenter e o WhatsApp bane).
PROXY_AUTO_ASSIGN=true

# Aquecimento (padrões; ajuste se quiser)
WARMUP_DAY1_LIMIT=15
WARMUP_TOTAL_DAYS=15
WARMUP_MAX_DAILY=400
WARMUP_INACTIVITY_RESET_HOURS=72

# Alertas (opcional: Telegram/Discord/webhook)
ALERT_WEBHOOK_URL=""
LOG_LEVEL=info
